From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: diaaney <latte@diane.zip>
Date: Thu, 30 Jul 2026 08:09:29 -0700
Subject: [PATCH] rapier - hooked bobber is hidden from its victim (client pins
 it at eye height; server repositioning cannot fix the view)


diff --git a/net/minecraft/world/entity/projectile/FishingHook.java b/net/minecraft/world/entity/projectile/FishingHook.java
index c8687706970ea2f971415bc892cc314efbff3986..ba2d750d5bd67d0b2ea596e5070097eb13bcd3cd 100644
--- a/net/minecraft/world/entity/projectile/FishingHook.java
+++ b/net/minecraft/world/entity/projectile/FishingHook.java
@@ -334,6 +334,10 @@ public class FishingHook extends Projectile {
                 }
             }
             this.setHookedEntity(result.getEntity());
+            // rapier - hide the hooked bobber from its victim only. the hooked position is computed CLIENT-side (the client's own FishingHook tick pins it at eye height via DATA_HOOKED_ENTITY), so server-side repositioning can't unblock the victim's view -- instead the victim's client just never renders it. the angler and everyone else still see the bobber and line normally.
+            if (result.getEntity() instanceof net.minecraft.server.level.ServerPlayer rapierHookedPlayer) {
+                rapierHookedPlayer.connection.send(new net.minecraft.network.protocol.game.ClientboundRemoveEntitiesPacket(this.getId()));
+            }
         }
     }
 
